FROM docker.io/library/debian:trixie
RUN apt-get update
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ansible-core ca-certificates dbus mosquitto mosquitto-clients passwd \
    sudo systemd systemd-sysv
COPY controller/controller.py controller/config.yaml /workspace/controller/
COPY systemd/fridge-controller.service /workspace/systemd/
COPY ansible/ /workspace/ansible/
WORKDIR /workspace/ansible
CMD ["/sbin/init"]
